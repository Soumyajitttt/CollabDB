# Copy to apps/server/.env and fill in JWT_SECRET.
DATABASE_URL=postgres://collab:collab@localhost:5432/collabdb
# At least 32 chars. MUST be identical to JWT_SECRET in apps/web/.env.local.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
PORT=4000
WEB_ORIGIN=http://localhost:3000
