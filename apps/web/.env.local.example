# Copy to apps/web/.env.local and fill in both secrets.
NEXTAUTH_URL=http://localhost:3000
# Signs the NextAuth session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=
# MUST be identical to JWT_SECRET in apps/server/.env (the server verifies the tokens the web app mints).
JWT_SECRET=
# Where the web SERVER reaches the sync server (login check) and where the BROWSER connects.
AUTH_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
